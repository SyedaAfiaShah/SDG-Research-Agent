# LLM API Keys
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ChromaDB Config
CHROMA_PERSIST_DIR=data/chromadb

# LLM Backend Config
LLM_PROVIDER=gemini  # Options: openai, gemini
LLM_MODEL=gemini-1.5-pro  # Options: gpt-4o, gemini-1.5-pro, etc.
EMBEDDING_MODEL=gemini-embedding-001  # Options: text-embedding-3-small, gemini-embedding-001

# Chunking Config
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_RETRIEVAL_RESULTS=5

# Evaluation Config
EVALUATION_THRESHOLD=0.7
